<div class="row">
  <% @snapshot.world_counts.each do |status, count| %>
    <div class="card">
      <div class="label">Worlds <%= status %></div>
      <div class="metric"><%= count %></div>
    </div>
  <% end %>
</div>

<div class="row">
  <% @snapshot.quotas.each do |resource, quota| %>
    <div class="card">
      <div class="label">Cuota diaria · <%= resource %></div>
      <div class="metric">
        <%= quota[:used] %> / <%= quota[:limit].nil? ? "∞" : quota[:limit] %>
      </div>
      <div class="dim">UTC · <%= quota[:period_start] %></div>
      <% if quota[:limit] %>
        <% percentage = quota[:limit].zero? ? 100 : [(quota[:used] * 100.0 / quota[:limit]).round, 100].min %>
        <div class="bar" style="margin-top:8px"><div style="width:<%= percentage %>%"></div></div>
      <% end %>
    </div>
  <% end %>
</div>

<div class="card">
  <div class="label">Intentos</div>
  <div class="row" style="margin-top:10px">
    <% @snapshot.attempt_counts.each do |status, count| %>
      <div style="min-width:120px">
        <span class="pill <%= status %>"><%= status %></span>
        <span class="mono"><%= count %></span>
      </div>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="label">Worlds recientes</div>
  <% if @snapshot.recent_worlds.empty? %>
    <div class="empty">Todavía no hay ejecución de exploración para este tenant.</div>
  <% else %>
    <table style="margin-top:10px">
      <thead>
        <tr><th>world</th><th>política</th><th>estado</th><th>rondas / nodos</th><th>score</th><th>fin</th></tr>
      </thead>
      <tbody>
        <% @snapshot.recent_worlds.each do |world| %>
          <tr>
            <td class="mono"><%= world[:id] %></td>
            <td><%= world[:policy_name] %>@<%= world[:policy_version] %></td>
            <td><span class="pill <%= world[:status] %>"><%= world[:status] %></span></td>
            <td class="mono"><%= world[:rounds] %> / <%= world[:node_count] %></td>
            <td class="mono"><%= world[:best_score]&.round(4) || "—" %></td>
            <td class="dim"><%= world[:stop_reason] || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<div class="card">
  <div class="label">Revisión de promociones</div>
  <% if @reviews.empty? %>
    <div class="empty">No hay recomendaciones estadísticas sometidas a revisión.</div>
  <% else %>
    <table style="margin-top:10px">
      <thead>
        <tr><th>target</th><th>cambio</th><th>estado</th><th>evidencia</th><th>decisión</th></tr>
      </thead>
      <tbody>
        <% @reviews.each do |review| %>
          <% active = @bindings[review.target]&.review_id == review.id %>
          <tr>
            <td class="mono"><%= review.target %></td>
            <td>
              <%= review.incumbent_name %>@<%= review.incumbent_version %>
              → <%= review.candidate_name %>@<%= review.candidate_version %>
              <% if active %><span class="pill completed">active</span><% end %>
            </td>
            <td><span class="pill <%= review.status %>"><%= review.status %></span></td>
            <td title="<%= review.evidence_digest %>">
              <span class="mono"><%= review.evidence_digest.to_s.first(20) %>…</span>
              <% if review.evidence["level"] == "harness" %>
                <% study = review.evidence.fetch("holdout") %>
                <% comparison = review.evidence.fetch("comparison").stringify_keys %>
                <details>
                  <summary>Governed Self-Improvement · <%= study["study_id"] %></summary>
                  <p>
                    Holdout: <%= comparison["sample_size"] %> tareas independientes;
                    <%= study["repetitions"] %> repeticiones por variante.
                    Δ calidad: <%= comparison["mean_difference"] %>;
                    IC <%= comparison["confidence_level"] %>:
                    [<%= comparison["ci_lower"] %>, <%= comparison["ci_upper"] %>].
                  </p>
                  <p>Pareto entrenamiento: <%= Array(review.evidence["pareto_frontier"]).join(", ") %></p>
                  <table>
                    <thead><tr><th>Holdout</th><th>Calidad ↑</th><th>Costo ↓</th><th>Latencia ↓</th></tr></thead>
                    <tbody>
                      <% review.evidence.fetch("holdout_evaluations").each do |evaluation| %>
                        <tr>
                          <td><%= evaluation["policy_name"] %></td>
                          <td><%= evaluation["mean_quality"] %></td>
                          <td><%= evaluation["mean_cost"] %></td>
                          <td><%= evaluation["mean_latency"] %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </details>
              <% end %>
            </td>
            <td>
              <% if review.pending? %>
                <%= form_with url: exploration_review_approve_path(review.id), method: :post, local: true,
                              style: "display:inline" do |form| %>
                  <%= form.text_field :reason, placeholder: "motivo (opcional)", size: 18 %>
                  <%= form.submit "Aprobar" %>
                <% end %>
                <%= form_with url: exploration_review_reject_path(review.id), method: :post, local: true,
                              style: "display:inline" do |form| %>
                  <%= form.text_field :reason, placeholder: "motivo requerido", required: true, size: 18 %>
                  <%= form.submit "Rechazar" %>
                <% end %>
              <% elsif active %>
                <%= form_with url: exploration_review_rollback_path(review.id), method: :post, local: true,
                              style: "display:inline" do |form| %>
                  <%= form.text_field :reason, placeholder: "motivo requerido", required: true, size: 18 %>
                  <%= form.submit "Rollback" %>
                <% end %>
              <% else %>
                <span class="dim"><%= review.reviewed_by || "—" %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<div class="card">
  <div class="label">Architecture Evaluation · reportes</div>
  <% if @architecture_reports.empty? %>
    <div class="empty">No hay evaluaciones de arquitectura registradas.</div>
  <% end %>
  <% @architecture_reports.each do |report| %>
    <% evaluation = report.fetch("architecture_evaluation") %>
    <% held = evaluation.fetch(report.fetch("phase")) %>
    <details>
      <summary><%= report["study_id"] %> · <%= report["selected"] %> · <%= report["phase"] %> · <%= report["status"] %> · regresiones: <%= held["regressions"] %></summary>
      <p>Compuerta: <%= held["allowed"] ? "aprobada" : "bloqueada" %> · <%= held["reasons"].join(", ") %></p>
      <p>Cadenas cubiertas: <%= held.dig("coverage", "covered_count") %> / <%= held.dig("coverage", "required_count") %></p>
      <% held.dig("coverage", "missing_chains").each do |chain| %>
        <p>Cadena sin cobertura: <%= chain.join(" → ") %></p>
      <% end %>
      <table>
        <thead><tr><th>Tarea (digest)</th><th>Éxito base → candidato</th><th>Transición</th><th>Δ calidad</th><th>Δ costo</th><th>Δ latencia</th><th>Checks fallidos</th></tr></thead>
        <tbody>
          <% held.fetch("tasks").each do |task| %>
            <tr>
              <td class="mono" title="<%= task["task_digest"] %>"><%= task["task_digest"].first(20) %><%= task["critical"] ? " · critical" : "" %></td>
              <td><%= task.dig("baseline", "success_rate") %> → <%= task.dig("candidate", "success_rate") %></td>
              <td><%= task["transition"] %></td>
              <td><%= task["quality_delta"] %></td><td><%= task["cost_delta"] %></td><td><%= task["latency_delta"] %></td>
              <td><%= task["failed_checks"].join(", ") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if (diagnostics = report["delegation_diagnostics"]) %>
        <p>Diagnóstico de delegación · <%= diagnostics["request_count"] %> requests; las propuestas requieren evaluación.</p>
        <table>
          <thead><tr><th>Agente</th><th>Decisión propuesta</th><th>Motivo</th></tr></thead>
          <tbody>
            <% diagnostics.fetch("agents").each do |agent| %>
              <tr><td><%= agent["name"] %></td><td><%= agent["decision"] %></td><td><%= agent["reason"] %></td></tr>
            <% end %>
            <% diagnostics.fetch("pairs").select { |pair| pair["decision"] == "merge_candidate" }.each do |pair| %>
              <tr><td><%= pair["agents"].join(" + ") %></td><td>merge_candidate</td><td><%= pair["reason"] %></td></tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </details>
  <% end %>
</div>

<p class="dim">
  Actualizado <%= @snapshot.generated_at.utc.iso8601 %>.
  Aprobar sólo cambia un binding declarativo auditable; nunca registra ni ejecuta código.
</p>
